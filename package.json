{
  "name": "romm-client",
  "version": "1.1.0",
  "description": "Electron app that plugs into the RomM API to provide a desktop experience",
  "desktopName": "fr.chaun14.rommclient.desktop",
  "main": "./out/main.js",
  "scripts": {
    "start": "npm run build && electron .",
    "dev": "npm run build && electron . --dev",
    "dev:offline": "npm run build && electron . --dev --offline",
    "build": "npm run build:main && npm run build:renderer && npm run copy-assets",
    "build:main": "tsc",
    "build:renderer": "vite build",
    "copy-assets": "node scripts/copy-renderer-assets.js",
    "dist": "electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux",
    "publish": "npm run publish:win",
    "publish:win": "npm run build && electron-builder --win --publish always",
    "publish:linux": "npm run build && electron-builder --linux --publish always"
  },
  "keywords": [
    "romm",
    "emulator",
    "roms",
    "gaming"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/adm-zip": "^0.5.8",
    "@types/ini": "^4.1.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/unzipper": "^0.10.11",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.5.4",
    "electron": "^44.1.1",
    "electron-builder": "^26.15.3",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "^4.8.3",
    "vite": "^8.2.2"
  },
  "dependencies": {
    "adm-zip": "^0.6.0",
    "axios": "^1.20.0",
    "crc-32": "^1.2.2",
    "dotenv": "^17.4.2",
    "electron-updater": "^6.8.9",
    "form-data": "^4.0.6",
    "ini": "^7.0.0",
    "lucide-react": "^1.40.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tslib": "^2.8.1",
    "unzipper": "^0.12.5"
  },
  "build": {
    "appId": "fr.chaun14.rommclient",
    "productName": "RomM Client",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "publish": {
      "provider": "github",
      "owner": "chaun14",
      "repo": "romm-client"
    },
    "win": {
      "target": "nsis",
      "publish": [
        "github"
      ]
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage",
      "category": "Game",
      "icon": "src/renderer/assets/imgs/icon.png",
      "executableName": "romm-client",
      "syncDesktopName": true,
      "artifactName": "RomMClient-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "RomMClient-Setup-${version}-${arch}.${ext}",
      "runAfterFinish": true,
      "differentialPackage": true
    }
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true
  }
}
