{
  "name": "romm-client",
  "version": "1.0.7",
  "description": "Electron app that plugs into the RomM API to provide a desktop experience",
  "main": "./out/main.js",
  "scripts": {
    "start": "npm run build && electron .",
    "dev": "npm run build && electron . --dev",
    "build": "npm run build:main && npm run build:renderer && npm run copy-assets",
    "build:main": "tsc",
    "build:renderer": "vite build",
    "copy-assets": "node scripts/copy-renderer-assets.js",
    "dist": "electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux",
    "publish": "npm run build && electron-builder --win --publish always"
  },
  "keywords": [
    "romm",
    "emulator",
    "roms",
    "gaming"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@types/adm-zip": "^0.5.7",
    "@types/ini": "^4.1.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/unzipper": "^0.10.11",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "electron": "^39.7.0",
    "electron-builder": "^26.8.1",
    "postcss": "^8.5.14",
    "tailwindcss": "^4.3.0",
    "typescript": "^4.8.3",
    "vite": "^8.0.12"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "axios": "^1.6.2",
    "crc-32": "^1.2.2",
    "dotenv": "^17.3.1",
    "electron-updater": "^6.8.3",
    "form-data": "^4.0.5",
    "ini": "^6.0.0",
    "lucide-react": "^1.14.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tslib": "^2.8.1",
    "unzipper": "^0.12.3"
  },
  "build": {
    "appId": "fr.chaun14.rommclient",
    "productName": "RomM Client",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "publish": {
      "provider": "github",
      "owner": "chaun14",
      "repo": "romm-client"
    },
    "win": {
      "target": "nsis",
      "publish": [
        "github"
      ]
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "RomMClient-Setup-${version}-${arch}.${ext}",
      "runAfterFinish": true,
      "differentialPackage": true
    }
  }
}
